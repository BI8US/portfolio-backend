generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id        Int      @id @default(autoincrement())
  userName  String   @unique @map("user_name")
  email     String   @unique
  password  String
  role      String   @default("USER")
  isActive  Boolean  @map("is_active")
  createdAt DateTime @map("created_at") @db.Timestamp(6)
}

model resumes {
  id         Int      @id @default(autoincrement())
  resumeName String   @map("resume_name")
  isActive   Boolean  @default(false) @map("is_active")
  fullName   String?  @map("full_name")
  email      String?
  phone      String?
  picture    String?
  summary    String?  @db.VarChar(1000)
  location   String?
  intro      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  educations      educations[]
  mediaLinks      mediaLinks[]
  projects        projects[]
  skillGroups     skillGroups[]
  workExperiences workExperiences[]
}

model educations {
  id            Int     @id @default(autoincrement())
  school        String?
  educationName String? @map("education_name")
  startDate     String? @map("start_date")
  endDate       String? @map("end_date")
  description   String?
  sortOrder     Int     @default(0) @map("sort_order")
  resumeId      Int     @map("resume_id")
  resume        resumes @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model workExperiences {
  id          Int     @id @default(autoincrement())
  company     String?
  position    String?
  startDate   String? @map("start_date")
  endDate     String? @map("end_date")
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  resumeId    Int     @map("resume_id")
  resume      resumes @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("work_experiences")
}

model projects {
  id          Int     @id @default(autoincrement())
  title       String?
  subTitle    String? @map("sub_title")
  description String?
  media       String?
  sortOrder   Int     @default(0) @map("sort_order")
  resumeId    Int     @map("resume_id")
  resume      resumes @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model mediaLinks {
  id        Int     @id @default(autoincrement())
  name      String?
  link      String?
  sortOrder Int     @default(0) @map("sort_order")
  resumeId  Int     @map("resume_id")
  resume    resumes @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("media_links")
}

model skillGroups {
  id        Int     @id @default(autoincrement())
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  resumeId  Int     @map("resume_id")
  resume    resumes @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  skills skills[]

  @@map("skill_groups")
}

model skills {
  id        Int    @id @default(autoincrement())
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  skillGroupId Int         @map("skill_group_id")
  skillGroup   skillGroups @relation(fields: [skillGroupId], references: [id], onDelete: Cascade)
}

model jobApplications {
  id          Int      @id @default(autoincrement())
  link        String?
  contact     String?
  status      String
  company     String
  role        String
  schedule    String?
  description String?  @db.Text
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("job_applications")
}
